require_relative '../../../read_test'

module USQualityCoreTestKit
  module <%= module_name %>
    class <%= class_name %> < Inferno::Test
      include USQualityCoreTestKit::ReadTest

      title 'Server returns correct <%= resource_type %> resource from <%= resource_type %> read interaction'

      description 'A server <%= conformance_expectation %> support the <%= resource_type %> read interaction.'

      id :<%= test_id %><% if group_metadata.reformatted_version == 'v100_ballot' && conformance_expectation == 'SHALL' %>
      verifies_requirements 'us-quality-core-v1.0.0-ballot@CONF-5'<% end %>

      def resource_type
        '<%= resource_type %>'
      end

      def scratch_resources
        scratch[:<%= profile_identifier %>_resources] ||= {}
      end

      run do
        perform_read_test(<%= resource_collection_string %>)
      end
    end
  end
end
