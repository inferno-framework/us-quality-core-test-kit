BASE_URL = 'http://localhost:4567/custom/us_quality_core_client_<%= ig_metadata.reformatted_version %>/fhir'
CLIENT_ID = 'test'

client = FHIR::Client.new(BASE_URL)
client.additional_headers = { Authorization: "Bearer #{CLIENT_ID}" }
client.use_r4

FHIR::Model.client = client

CLIENT_EXAMPLE_RESULTS = []

def record_result(result, label = nil, message = nil)
  CLIENT_EXAMPLE_RESULTS << { label:, result:, message: }

  return if result == :pass

  label ||= 'FHIR search'
  detail = message.present? ? " - #{message}" : ''
  puts "#{result.to_s.upcase}: #{label}#{detail}"
end

def search_url(bundle)
  return unless bundle.respond_to?(:link)

  self_link = Array(bundle.link).find { |link| link.respond_to?(:relation) && link.relation == 'self' }
  self_link.url if self_link.respond_to?(:url)
end

def results?(bundle)
  if bundle.respond_to?(:entry) && bundle.entry.present?
    record_result(:pass)
  else
    record_result(:skip, search_url(bundle), 'search response bundle was empty')
  end
end

def print_client_example_summary
  counts = CLIENT_EXAMPLE_RESULTS.map { |result| result[:result] }.tally
  total = CLIENT_EXAMPLE_RESULTS.length

  puts
  puts "Client example search summary: total=#{total} pass=#{counts[:pass].to_i} skip=#{counts[:skip].to_i} fail=#{counts[:fail].to_i} error=#{counts[:error].to_i}"

  non_pass = CLIENT_EXAMPLE_RESULTS.reject { |result| result[:result] == :pass }
  return if non_pass.empty?

  puts
  puts 'Non-pass checks:'
  non_pass.each do |result|
    detail = result[:message].present? ? " - #{result[:message]}" : ''
    puts "#{result[:result].to_s.upcase}: #{result[:label]}#{detail}"
  end
end

